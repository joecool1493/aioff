---
import Base from '../layouts/Base.astro';
import index from '@aioff/dns/dist/index.json';
import { GITHUB, LISTS_BASE, LISTS_PUBLISHED, STORE_URLS } from '../config';
const stores = [
  { title: 'Chrome and Chromium', body: 'Chrome, Brave, Arc, Opera, Vivaldi.', status: 'Chrome Web Store download: not available yet.', label: 'Get it on Chrome Web Store', url: STORE_URLS.chrome },
  { title: 'Edge', body: 'Microsoft Edge.', status: 'Edge Add-ons download: not available yet.', label: 'Get it on Edge Add-ons', url: STORE_URLS.edge },
  { title: 'Firefox', body: 'Desktop and Android.', status: 'Firefox Add-ons download: not available yet.', label: 'Get it on Firefox Add-ons', url: STORE_URLS.firefox },
  { title: 'Safari', body: 'Mac, iPhone, iPad.', status: 'App Store download: not available yet.', label: 'Get it on App Store', url: STORE_URLS.safari },
];
---
<Base title="Download AI Off" description="Find browser releases, source builds, and free network lists. Check what is available before installing.">
  <h1>Get the off switch</h1>
  <p class="intro">All four browser levels, personal rules, and rule updates. Free forever. No account.</p>

  <h2>Browser downloads</h2>
  <div class="grid two">
    {stores.map((s) => (
      <div class="card"><h3>{s.title}</h3><p>{s.body}</p>{s.url ? <a class="btn" href={s.url}>{s.label}</a> : <p class="status">{s.status}</p>}</div>
    ))}
  </div>
  <p style="margin-top:24px"><a href={`${GITHUB}#readme`}>Build from source</a></p>
  <p>Source builds need developer tools. Firefox temporary add-ons disappear after restart. Safari needs Apple packaging tools. A desktop source build does not install an iPhone app.</p>
  <p><a href="/computer/">Computer and phone settings</a></p>

  <h2 id="network">Network lists</h2>
  <p>Free, MIT-licensed domain lists for a blocker or DNS service. Lists cannot hide buttons inside allowed sites.</p>
  <div class="grid two">
    <div class="card"><h3>AI ads and tracking</h3><p>{index.tiers.ads} domains. Listed AI advertising, analytics, and tracking endpoints. Main chatbot sites stay accessible.</p></div>
    <div class="card"><h3>Blackout</h3><p>{index.tiers.products} domains. Listed chatbots, generators, and APIs. Dependent apps may stop working.</p></div>
  </div>
  <div class="notice"><p>Blackout blocks AI tools you may use. It is optional.</p></div>
  <p>Shared service domains are excluded to reduce unrelated blocking. Apps can still break.</p>
  {!LISTS_PUBLISHED && <p class="status">Published list downloads are not available yet.</p>}
  <p><a href={`${GITHUB}/tree/main/packages/dns`}>Get the list source</a></p>
  <div class="table-scroll"><table>
    <thead><tr><th>File</th><th>Use with</th><th>Download</th></tr></thead>
    <tbody>
      {index.formats.map((f) => (
        <tr><td><code>{f.file}</code></td><td>{f.for}</td>
          <td>{LISTS_PUBLISHED ? <><a href={`${LISTS_BASE}/ads/${f.file}`}>Download ads/{f.file}</a><br /><a href={`${LISTS_BASE}/products/${f.file}`}>Download products/{f.file}</a></> : <span class="soft">Not available yet</span>}</td></tr>
      ))}
    </tbody>
  </table></div>
  <p style="margin-top:24px">Import a supported format using the chosen tool's instructions. Provider support and plan limits vary. Pause or remove lists in that tool.</p>
  <p>DNS requests go to the chosen provider under its privacy policy. AI Off does not run that service.</p>
  <p>The Pro DNS profile is not available yet, pending a partner. Free lists do not require Pro.</p>
</Base>
