 "commands": [
  {
   "id": "copilot-app-uninstall",
   "title": "Uninstall the consumer Microsoft Copilot app for the current user",
   "shell": "powershell",
   "command": "$p = Get-AppxPackage -Name \"Microsoft.Copilot\" | Select-Object -ExpandProperty PackageFullName; if ($p) { Remove-AppxPackage -Package $p }",
   "needsAdmin": false,
   "verified": true,
   "source": "https://learn.microsoft.com/en-us/windows/client-management/manage-windows-copilot"
  },
  {
   "id": "recall-remove-feature",
   "title": "Remove the Recall optional feature",
   "shell": "powershell",
   "command": "Disable-WindowsOptionalFeature -Online -FeatureName \"Recall\" -Remove",
   "needsAdmin": true,
   "verified": true,
   "source": "https://learn.microsoft.com/en-us/windows/client-management/manage-recall"
  },
