      "textAnchors": [
        "Summarize this data"
      ],
      "anchorTarget": "control",
      "description": "Sheets: Summarize this data, Gemini formula fix or generate, Insert AI column",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
