      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    },
    {
      "id": "gforms-help-me-create",
      "kind": "hide",
      "selectors": [
        "[data-action-id=\"freebird-open-help-me-ask-from-icon\"]",
        "[role=\"menuitem\"]:has(> [data-action-id=\"freebird-open-help-me-ask-from-icon\"])"
