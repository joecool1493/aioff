        "#openSidekickForSlideGenerationButton",
        ".goog-menuitem:has([aria-label^=\"Help me visualize\"])",
        ".goog-menuitem:has([aria-label^=\"Create a slide\"])",
        ".goog-menuitem:has([aria-label^=\"Beautify this slide\"])"
      ],
      "textAnchors": [
        "Help me visualize",
        "Beautify this slide"
      ],
      "anchorTarget": "control",
      "description": "Slides: slide and image generation entry points and menu items",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
