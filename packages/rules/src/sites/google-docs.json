{
  "id": "google-docs",
  "name": "Google Docs, Sheets, Slides",
  "category": "google",
  "match": [
    "*://docs.google.com/*"
  ],
  "level": 1,
  "rules": [
    {
      "id": "gdocs-gemini-header-button",
      "kind": "hide",
      "selectors": [
        "#docs-sidekick-button-container",
        "#docs-sidekick-gen-ai-promo-button-container",
        ".appsElementsSidekickAuroraEntryPointRoot"
      ],
      "textAnchors": [
        "Ask Gemini",
        "Try Gemini"
      ],
      "anchorTarget": "control",
      "description": "Gemini button in the editor header (opens side panel) and its promo variant",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt",
          "https://github.com/easylist/easylist/blob/master/fanboy-addon/fanboy_ai_suggestions.txt"
        ]
      }
    },
    {
      "id": "gdocs-help-me-write-pill",
      "kind": "hide",
      "selectors": [
        ".superfab-aitextgeneratormenu-button",
        ".WithHideTransition.kixWizBarkickWrapper",
        ".appsElementsSidekickBarkickMinimizedButton",
        ".appsElementsCalloutIsPrimary.appsElementsCalloutAnchorPaddingContainer"
      ],
      "textAnchors": [
        "Help me write",
        "Write with Gemini"
      ],
      "anchorTarget": "control",
      "description": "Floating Help me write pill and Write with Gemini footer bar in Docs",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt",
          "https://github.com/easylist/easylist/blob/master/fanboy-addon/fanboy_ai_suggestions.txt"
        ]
      }
    },
    {
      "id": "gdocs-refine-selection",
      "kind": "hide",
      "selectors": [
        ".inlineFabBubbleContainerRefineButtonContainer",
        ".appsSketchyPluginsFloatingToolbarFloatingToolbarComponentGenerativeAiButton"
      ],
      "description": "Refine (AI rewrite) icon in the text selection bubble (Docs) and floating toolbar (Slides)",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    },
    {
      "id": "gdocs-menu-gemini",
      "kind": "hide",
      "selectors": [
        "#docs-gemini-menu",
        ".ai-standard-menu-item",
        ".apps-menuitem:has(.goog-menuitem-label[aria-label=\"Gemini 2\"])"
      ],
      "description": "Gemini top-level menu (Sheets) and AI menu items in Tools",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    },
    {
      "id": "gdocs-audio-tts",
      "kind": "hide",
      "selectors": [
        "#textToSpeechToolbarButton"
      ],
      "textAnchors": [
        "Listen to this tab"
      ],
      "description": "AI audio (Listen to this tab) toolbar button",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
