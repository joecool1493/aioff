      "textAnchors": [
        "Help me create a form"
      ],
      "anchorTarget": "control",
      "description": "Forms: Help me create a form button",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
