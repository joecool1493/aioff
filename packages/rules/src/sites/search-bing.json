{
  "id": "search-bing",
  "name": "Bing",
  "category": "search",
  "match": [
    "*://www.bing.com/*"
  ],
  "level": 1,
  "rules": [
    {
      "id": "bing-force-web",
      "kind": "urlRewrite",
      "when": {
        "paramMissing": [
          "webscp"
        ],
        "pathPrefix": "/search?"
      },
      "set": {
        "webscp": "1"
      },
      "description": "Use Bing's own Web results view (webscp=1) so the Copilot answer never loads. Also drops other answer boxes.",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "Bing's own Web tab param. Verified live: Copilot answer, follow-up composer and all .b_ans removed. Copilot tabs remain."
      }
    },
    {
      "id": "b-copilot-answer",
      "kind": "hide",
      "selectors": [
        ".b_ans:has(> #copans_container)",
        "#copans_container",
        ".b_ans.b_top:has(> .cht_container)",
        ".b_ans:has(> #b_wpt_container_ml)",
        ".b_ans:has(> .utilAns)"
      ],
      "description": "Copilot Search summary and generative answer variants",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "Stevos-AI-Blocklist (MIT); first two reproduced live"
      }
    },
    {
      "id": "b-copilot-followup",
      "kind": "hide",
      "selectors": [
        "#b_copilot_search_container",
        "#b_copilot_search"
      ],
      "textAnchors": [
        "Ask a follow-up"
      ],
      "description": "Copilot follow-up composer at page bottom",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "Stevos-AI-Blocklist (MIT); reproduced live"
      }
    },
    {
      "id": "b-copilot-tabs",
      "kind": "hide",
      "selectors": [
        "#b-scopeListItem-copilotsearch",
        "#b-scopeListItem-conv"
      ],
      "description": "Copilot Search and Copilot tabs",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "Stevos-AI-Blocklist (MIT); reproduced live"
      }
    },
    {
      "id": "b-header-copilot",
      "kind": "hide",
      "selectors": [
        "#codex",
        ".cdxCopilotIconBg",
        "#m365copilot_overflow",
        "a[href^=\"/chat?FORM=hpcodx\"]"
      ],
      "description": "Header Copilot buttons",
      "since": "2026-09-20",
      "x": {
        "confidence": "med",
        "source": "Stevos-AI-Blocklist (MIT); EasyList AI list (fact)"
      }
    },
    {
      "id": "b-ai-tools",
      "kind": "hide",
      "selectors": [
        "#aitools",
        "#sa_ai_block",
        "#imgcrtr_key",
        ".b_insights",
        "#chat_upsell_bubble_icon",
        "#ccpg-container:has(#b_cp_upsell_box_parent)",
        ".conversation_starters"
      ],
      "textAnchors": [
        "Try it on Copilot"
      ],
      "description": "AI creator buttons, insights and Copilot upsells",
      "since": "2026-09-20",
      "x": {
        "confidence": "med",
        "source": "Stevos-AI-Blocklist (MIT); EasyList AI list (fact)"
      }
    }
  ],
  "healthcheck": {
    "entries": [
      {
        "url": "https://www.bing.com/search?q=mario+last+name&setlang=en-US&cc=US",
        "expect": [
          "b-copilot-followup",
          "b-copilot-tabs"
        ]
      },
      {
        "url": "https://www.bing.com/search?q=apache+airflow+dag&setlang=en-US&cc=US",
        "expect": [
          "b-copilot-followup",
          "b-copilot-tabs"
        ]
      }
    ]
  }
}
