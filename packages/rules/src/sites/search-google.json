    {
      "id": "g-autocomplete-aimode",
      "kind": "hide",
      "selectors": [
        "li[data-attrid$=\"Prediction\"]:has([aria-description=\"AI Mode\"])",
        ".CKtgbd[role=\"listbox\"] > .sbct:has(.cuyMBe)"
      ],
      "textAnchors": [
        "AI Mode"
      ],
      "description": "AI Mode suggestions in search autocomplete",
      "since": "2026-09-20",
      "x": {
        "confidence": "med",
        "source": "EasyList AI list (fact); Stevos-AI-Blocklist (MIT)"
      }
    }
  ],
  "healthcheck": {
    "entries": [
      {
        "url": "https://www.google.com/search?q=why+is+the+sky+blue&hl=en&gl=us"
      },
      {
        "url": "https://www.google.com/search?q=Why+are+we+here&hl=en&gl=us"
