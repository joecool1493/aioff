{
  "id": "stackoverflow",
  "name": "Stack Overflow and Stack Exchange",
  "category": "knowledge",
  "match": [
    "*://stackoverflow.com/*",
    "*://*.stackexchange.com/*",
    "*://superuser.com/*",
    "*://serverfault.com/*",
    "*://askubuntu.com/*"
  ],
  "level": 1,
  "rules": [
    {
      "id": "so-ai-assist-nav",
      "kind": "hide",
      "selectors": [
        "#nav-askstack"
      ],
      "textAnchors": [
        "AI Assist"
      ],
      "anchorTarget": "control",
      "description": "AI Assist item in the left sidebar",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    },
    {
      "id": "so-ai-assist-home",
      "kind": "hide",
      "selectors": [
        "#mainbar > div:has(textarea#ask-stack-initial-question)",
        "#hide-this-if-you-want > div > div > div.d-flex.fd-column.as-start"
      ],
      "textAnchors": [
        "AI Assist",
        "Get instant answers"
      ],
      "description": "AI Assist chat box on the home page",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt",
          "https://github.com/easylist/easylist/blob/master/fanboy-addon/fanboy_ai_suggestions.txt"
        ]
      }
    },
    {
      "id": "so-agents-promo",
      "kind": "hide",
      "selectors": [
        "#announcement-banner:has([href^=\"https://agents.stackoverflow.com/\"])",
        "div:has(> #nav-sofa)",
        ".js-sofa-sidebar-promo"
      ],
      "textAnchors": [
        "Stack Overflow for Agents"
      ],
      "anchorTarget": "control",
      "description": "Stack Overflow for Agents banner, nav item, and sidebar promo",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    }
  ],
  "healthcheck": {
    "entries": [
      {
        "url": "https://stackoverflow.com/questions",
        "expect": [
          "so-ai-assist-nav",
          "so-ai-assist-home",
          "so-agents-promo"
        ]
      }
    ]
  }
}
