{
  "id": "search-yahoo",
  "name": "Yahoo Search",
  "category": "search",
  "match": [
    "*://search.yahoo.com/*",
    "*://www.yahoo.com/*"
  ],
  "level": 1,
  "rules": [
    {
      "id": "y-ai-summary",
      "kind": "hide",
      "selectors": [
        "#web li:has(> .genAiDD)",
        ".genAiDD",
        ".summary-container:has(> .ai-summary)"
      ],
      "textAnchors": [
        "AI Summary",
        "Summaries may be generated by AI"
      ],
      "description": "AI Summary card at top of results",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "own live observation; Stevos-AI-Blocklist (MIT) for third"
      }
    },
    {
      "id": "y-scout",
      "kind": "hide",
      "selectors": [
        ".sb-scout-wrap",
        "li:has(> .scoutNav)",
        ".scout-tab",
        ".scoutPromo",
        ".scoutPromoPopup",
        ".searchRightBottom:has([href^=\"https://scout.yahoo.com/chat\"])",
        "[aria-label=\"Search with Yahoo Scout\"]",
        "[role=\"menuitem\"]:has(> [href^=\"https://scout.yahoo.com/\"])"
      ],
      "textAnchors": [
        "Yahoo Scout",
        "Explore AI results"
      ],
      "description": "Yahoo Scout entry points",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": "Stevos-AI-Blocklist (MIT); .sb-scout-wrap, .scoutNav and sidebar reproduced live"
      }
    }
  ],
  "healthcheck": {
    "entries": [
      {
        "url": "https://search.yahoo.com/search?p=why+is+the+sky+blue",
        "expect": [
          "y-ai-summary",
          "y-scout"
        ]
      }
    ]
  }
}
