{
  "id": "bestbuy",
  "name": "Best Buy",
  "category": "commerce",
  "match": [
    "*://www.bestbuy.com/*"
  ],
  "level": 1,
  "rules": [
    {
      "id": "bestbuy-ai-summary",
      "kind": "hide",
      "selectors": [
        "[data-component-name=\"AiReviewSummary\"]",
        "[data-component-name=\"AISummaryWrapper\"]",
        ".question-list-item:has(.ai-context-text)"
      ],
      "textAnchors": [
        "Customers are saying",
        "This summary was generated by AI based on customer reviews."
      ],
      "description": "Best Buy AI review summary and AI-answered questions",
      "since": "2026-09-20",
      "x": {
        "confidence": "high",
        "source": [
          "https://github.com/Stevoisiak/Stevos-AI-Blocklist/blob/main/GenAI-Blocklist.txt"
        ]
      }
    }
  ],
  "healthcheck": {
    "entries": [
      {
        "url": "https://www.bestbuy.com/"
      }
    ]
  }
}
