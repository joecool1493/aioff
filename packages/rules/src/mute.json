  "matchMode": "wordBoundary",
  "containers": {
    "x.com": [
      "article[data-testid='tweet']"
    ],
    "twitter.com": [
      "article[data-testid='tweet']"
    ],
    "reddit.com": [
      "shreddit-post",
      "shreddit-ad-post",
      "article:has(> shreddit-post)",
      "search-telemetry-tracker:has(a[data-testid='post-title'])"
    ],
    "linkedin.com": [
      "div.feed-shared-update-v2",
      "div[data-id^='urn:li:activity']",
      "article.news-module__storyline"
    ],
    "facebook.com": [
      "div[role='article'][aria-posinset]",
      "div[role='article'][aria-describedby]"
    ],
    "instagram.com": [
      "article"
    ],
    "threads.com": [
      "div[data-pressable-container='true']"
    ],
    "threads.net": [
      "div[data-pressable-container='true']"
    ],
    "bsky.app": [
      "div[data-testid^='feedItem-']",
      "div[data-testid^='postThreadItem-']"
    ],
    "youtube.com": [
      {
        "selector": "ytd-rich-item-renderer",
        "text": "#video-title, .yt-lockup-metadata-view-model__title, h3"
      },
      {
        "selector": "ytd-video-renderer",
        "text": "#video-title, #description-text"
      },
      {
        "selector": "ytd-compact-video-renderer",
        "text": "#video-title"
      },
      {
        "selector": "yt-lockup-view-model",
        "text": ".yt-lockup-metadata-view-model__title, h3"
      },
      {
        "selector": "ytd-reel-item-renderer, ytm-shorts-lockup-view-model",
        "text": "h3, #video-title"
      }
    ],
    "news.ycombinator.com": [
      {
        "selector": "tr.athing",
        "text": ".titleline",
        "nextSiblings": 1
      }
    ],
    "news.google.com": [
      "article"
    ],
    "substack.com": [
      "div.reader2-post-container",
      "div[class*='post-preview']",
      "article"
    ],
    "medium.com": [
      "article"
    ],
    "techmeme.com": [
      "div.item",
      "div.clus"
    ],
    "lobste.rs": [
      "li.story"
    ],
    "tumblr.com": [
      "article"
    ],
    "mastodon.social": [
      "article",
      "div.status"
    ]
  },
  "genericContainers": [
    "article",
    "li:has(> a h2, > a h3, h2 > a, h3 > a)",
    "[role='listitem']:has(h2, h3)",
    "div[class*='card']:has(> a h2, > a h3, h2 > a, h3 > a)"
  ],
  "headlineSelectors": [
    "h1",
    "h2",
    "h3",
    "h4",
    "a[class*='headline']",
    "a[class*='title']",
    "[class*='headline']"
